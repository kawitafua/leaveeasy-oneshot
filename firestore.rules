// ─────────────────────────────────────────────────────────────
// firestore.rules — กฎเฝ้าข้อมูลของ LeaveEasy
//
// สัปดาห์ที่ 7: กฎขั้นต่ำ "ต้องล็อกอินก่อน ถึงอ่าน/เขียนได้"
// ยังไม่แยกสิทธิ์ตามบทบาท (employee / manager / hr) หรือตามเจ้าของข้อมูล
// เช่น ผู้ขอลาคนหนึ่งยังเปิดใบลาของอีกคนได้อยู่ — เรื่องนี้เป็นงานของสัปดาห์ที่ 8
//
// {document=**} ครอบคลุมทุกโฟลเดอร์ (users, leaveTypes, leaveRequests)
// รวมถึงโฟลเดอร์ย่อย approvals ที่ซ้อนอยู่ในแต่ละใบลาด้วย เพราะ ** จับทุกระดับความลึก
// ─────────────────────────────────────────────────────────────

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
